# Sentinela — unidade systemd da bridge serial → MQTT
#
# Reinicia sozinha se o processo cair (queda de energia, exceção não tratada,
# placa desconectada por tempo demais) — é o que RC-02 exige da bridge tanto
# quanto dos nós de campo: silêncio prolongado tem que ser exceção, não modo
# de falha silencioso.
#
# Instalação no Raspberry Pi:
#   sudo cp gateway/sentinela-bridge.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now sentinela-bridge
#   journalctl -u sentinela-bridge -f      # acompanhar o log
#
# Ajustar ExecStart e WorkingDirectory ao caminho real de instalação no RPi
# antes de copiar. Valores abaixo: usuário sentinelapi, hostname sentinelapi
# (Raspberry Pi 4 de bancada, ADR-007), repositório em
# /home/sentinelapi/sentinela via rsync (não git clone — repo é privado e o
# RPi é host de runtime, não clone de desenvolvimento).
#
# Autoria: Matheus Marassi

[Unit]
Description=Sentinela — bridge LoRa serial para MQTT
After=network-online.target mosquitto.service
Wants=network-online.target

[Service]
Type=simple
User=sentinelapi
WorkingDirectory=/home/sentinelapi/sentinela/gateway
ExecStart=/home/sentinelapi/sentinela/tools/venv/bin/python /home/sentinelapi/sentinela/gateway/bridge.py --porta /dev/ttyUSB0 --broker localhost --bridge-id FAR-HTC03
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
