# Sentinela — ingestor MQTT → PostgreSQL/TimescaleDB.
#
# Depende do túnel (broker) e do Docker (banco). `Wants` em vez de `Requires`
# de propósito: se o túnel cair, o ingestor não deve morrer junto — ele
# reconecta sozinho, e sua sessão MQTT persistente faz o broker segurar as
# mensagens QoS 1 enquanto isso.
#
# **Unidade de usuário** — ver a nota em sentinela-tunel-mqtt.service.
#   cp backend/sentinela-ingestor.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now sentinela-ingestor
#   journalctl --user -u sentinela-ingestor -f
#
# Autoria: Luiz Matheus Marassi de Paula

[Unit]
Description=Sentinela — ingestor MQTT para PostgreSQL/TimescaleDB
After=sentinela-tunel-mqtt.service
Wants=sentinela-tunel-mqtt.service

[Service]
Type=simple
WorkingDirectory=/DATA/Projects/Sentinela/backend
Environment=PYTHONUNBUFFERED=1
ExecStart=/DATA/Projects/Sentinela/backend/venv/bin/python /DATA/Projects/Sentinela/backend/ingestor.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
