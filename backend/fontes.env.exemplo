# Sentinela — configuração das aquisições externas no Home Server.
# Copie para backend/fontes.env somente depois de definir os recortes. Tokens e
# senhas nunca entram no Git. O serviço também lê backend/.env para o banco.

SENTINELA_DADOS_EXTERNOS=/DATA/Projects/Sentinela-Data/externos
# Teto por resposta (50 MiB padrão). Sobrescreva por provedor somente após
# dimensionar armazenamento/rede, por exemplo INPE_MERGE_MAX_BYTES=...
SENTINELA_FONTES_MAX_BYTES=52428800

# CEMADEN PED — cadastro/token e um recorte são obrigatórios.
CEMADEN_PED_TOKEN=
CEMADEN_CODIBGE=
# Alternativa ao município: CEMADEN_CODESTACAO=
CEMADEN_FUSO=America/Sao_Paulo

# ANA HidroWebService — códigos de estação e janela são decisões explícitas.
ANA_IDENTIFICADOR=
ANA_SENHA=
ANA_ESTACOES=
ANA_INTERVALO=HORA_1
ANA_TIPO_FILTRO=DATA_LEITURA
# ANA_DATA_BUSCA=2026-08-01

# SGB — exemplo de forma, não um município escolhido pelo projeto:
# SGB_WHERE=cd_geocmu='CODIGO_IBGE_VALIDADO'

# REDEMET — URLs exatas dos produtos escolhidos, separadas por vírgula.
REDEMET_API_KEY=
REDEMET_URLS=

# Fontes por arquivo. Fixe URLs oficiais e produtos antes de ativar. Uma lista
# separada por vírgula é aceita; o bruto é deduplicado por SHA-256.
INPE_MERGE_URLS=
INPE_WRF_URLS=
NOAA_GFS_URLS=
INMET_URLS=
NASA_IMERG_URLS=
# Se a coleção exigir bearer: NASA_IMERG_AUTHORIZATION=Bearer ...
CHIRPS_URLS=
NOAA_GOES_URLS=
