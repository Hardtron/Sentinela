# Sentinela — configuração das aquisições externas no Home Server.
# Copie para backend/fontes.env somente depois de definir os recortes. Tokens e
# senhas nunca entram no Git. O serviço também lê backend/.env para o banco.

SENTINELA_DADOS_EXTERNOS=/DATA/Runtime/Sentinela-Data/externos
# Teto por resposta (50 MiB padrão). Sobrescreva por provedor somente após
# dimensionar armazenamento/rede, por exemplo INPE_MERGE_MAX_BYTES=...
SENTINELA_FONTES_MAX_BYTES=52428800

# CEMADEN PED — prefira as credenciais protegidas: o SGAA emite tokens de
# curta duração. CEMADEN_PED_TOKEN permanece como alternativa manual.
CEMADEN_PED_EMAIL=
CEMADEN_PED_PASSWORD=
CEMADEN_PED_TOKEN=
CEMADEN_CODIBGE=
# Alternativa ao município: CEMADEN_CODESTACAO=
# O CEMADEN declara que todos os dados são registrados em UTC/GMT.
CEMADEN_FUSO=UTC

# ANA HidroWebService — códigos de estação e janela são decisões explícitas.
ANA_IDENTIFICADOR=
ANA_SENHA=
ANA_ESTACOES=
ANA_INTERVALO=HORA_1
ANA_TIPO_FILTRO=DATA_LEITURA
# ANA_DATA_BUSCA=2026-08-01

# SGB — Caraguatatuba é o piloto (IBGE 3510500), mas a camada oficial
# consultada em 2026-08-01 não retornou feições para o município. Não configure
# uma consulta vazia como se fosse cobertura. Reavaliar quando o SGB publicar.
# SGB_WHERE=cd_geocmu='3510500'

# REDEMET — a chave é enviada somente no header X-Api-Key. URLs oficiais
# possíveis: satélite ir/realcada/vis e produtos/stsc. Para o piloto, o radar
# São Roque/SP (`area=sr`) foi validado pela resposta oficial: 03km (CAPPI
# 3,1 km/raio 250 km) e maxcappi (raio 400 km). São imagens contextuais.
REDEMET_API_KEY=
REDEMET_URLS=https://api-redemet.decea.mil.br/produtos/satelite/ir,https://api-redemet.decea.mil.br/produtos/satelite/realcada,https://api-redemet.decea.mil.br/produtos/satelite/vis,https://api-redemet.decea.mil.br/produtos/stsc,https://api-redemet.decea.mil.br/produtos/radar/03km?area=sr&anima=1,https://api-redemet.decea.mil.br/produtos/radar/maxcappi?area=sr&anima=1

# Fontes por arquivo. Fixe URLs oficiais e produtos antes de ativar. Uma lista
# separada por vírgula é aceita; o bruto é deduplicado por SHA-256.
INPE_MERGE_URLS=
INPE_WRF_URLS=
NOAA_GFS_URLS=
INMET_URLS=
# IMERG Early V07: o coletor consulta o ImageServer oficial, fixa o raster mais
# recente e exporta GeoTIFF na grade de 0,1° alinhada ao perímetro IBGE
# versionado em backend/recortes/3510500.geojson. Esse canal é público e não
# usa o token Earthdata; mantenha credenciais somente se outro produto exigir.
NASA_IMERG_CODIBGE=3510500
CHIRPS_URLS=
NOAA_GOES_URLS=
