# Sentinela — túnel SSH até o broker MQTT do Raspberry Pi.
#
# Por que existe: o Mosquitto do RPi escuta só em 127.0.0.1 e assim deve
# continuar enquanto não houver autenticação e TLS — broker anônimo aberto na
# rede aceita publicação de qualquer um, e telemetria forjada num sistema de
# alerta é pior do que telemetria nenhuma. O túnel dá acesso ao ingestor sem
# expor nada.
#
# A chave `id_sentinela_rpi` está registrada no RPi com
# `restrict,port-forwarding,permitopen="127.0.0.1:1883"`: serve só para
# encaminhar essa porta. Não abre shell nem pty mesmo se vazar.
# O destino usa mDNS e `HostKeyAlias`: o endereço muda entre Ethernet e Wi-Fi,
# mas a identidade criptográfica do Raspberry continua sendo uma só.
#
# **Unidade de usuário**, não de sistema: o sudo do homeserver exige senha, e
# o serviço não precisa de privilégio nenhum — só de uma chave SSH do próprio
# usuário. Instalação sem sudo:
#   mkdir -p ~/.config/systemd/user
#   cp backend/sentinela-tunel-mqtt.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now sentinela-tunel-mqtt
#
# Para sobreviver a reboot e a logout é preciso habilitar linger **uma vez**
# (é o único passo que pede sudo):
#   sudo loginctl enable-linger $USER
#
# Autoria: Luiz Matheus Marassi de Paula

[Unit]
Description=Sentinela — túnel SSH para o broker MQTT do Raspberry Pi

[Service]
Type=simple
ExecStart=/usr/bin/ssh -N -o BatchMode=yes -o ExitOnForwardFailure=yes -o ConnectTimeout=8 -o ServerAliveInterval=10 -o ServerAliveCountMax=2 -o StrictHostKeyChecking=accept-new -o HostKeyAlias=sentinela-rpi -i %h/.ssh/id_sentinela_rpi -L 127.0.0.1:1883:127.0.0.1:1883 sentinelapi@sentinelapi.local
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
