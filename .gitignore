# PlatformIO
.pio/
.pioenvs/
.piolibdeps/
firmware/.pio/

# Dumps de firmware e binários grandes (ver docs/HARDWARE.md)
*.bin
!firmware/**/partitions*.bin

# Python
__pycache__/
*.py[cod]
.venv/
venv*/

# Ambiente e segredos — chaves LoRaWAN, credenciais do banco, tokens
.env
*.local
secrets/
*.key
*.pem

# Dados de ensaio brutos (versionar apenas o consolidado em docs/)
data/raw/

# Estado de execução da bridge — não é código-fonte (gateway/bridge.py)
gateway/buffer.jsonl
gateway/.buffer.jsonl.tmp
gateway/buffer.jsonl.corrompido-*
backend/quarentena.jsonl
backend/fontes.env
data/externos/

# Sistema operacional e editores
.DS_Store
.vscode/
.idea/
*.swp
